<section class="explore-section" id="explore" data-explore-section aria-labelledby="explore-title">
  <div class="explore-section__inner">
    <header class="explore-section__header" data-explore-reveal>
      <div class="explore-section__heading-row">
        <h2 id="explore-title">Qué podés explorar</h2>
        <span class="explore-section__rule" aria-hidden="true"></span>
      </div>
      <p>Diferentes formas de entrar al mundo vegetal</p>
    </header>

    <div class="explore-section__grid">
      <a class="explore-card" href="/herbarium/" data-explore-reveal style="--explore-order: 1">
        <picture class="explore-card__paper" aria-hidden="true">
          <source
            type="image/webp"
            srcset="/images/explore/paper-1-720.webp 720w, /images/explore/paper-1-1000.webp 1000w"
            sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 1100px) 44vw, 22vw"
          />
          <img src="/images/explore/paper-1-720.webp" alt="" width="1000" height="314" loading="lazy" decoding="async" />
        </picture>
        <img class="explore-card__icon explore-card__icon--plantas" src="/images/explore/icon-plantas.webp" alt="" aria-hidden="true" width="136" height="160" loading="lazy" decoding="async" />
        <div class="explore-card__copy">
          <h3>Plantas</h3>
          <p>Explorá especies, historias y propiedades.</p>
        </div>
        <span class="explore-card__arrow" aria-hidden="true">→</span>
      </a>

      <a class="explore-card" href="#explore" data-explore-reveal style="--explore-order: 2">
        <picture class="explore-card__paper" aria-hidden="true">
          <source
            type="image/webp"
            srcset="/images/explore/paper-2-720.webp 720w, /images/explore/paper-2-1000.webp 1000w"
            sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 1100px) 44vw, 22vw"
          />
          <img src="/images/explore/paper-2-720.webp" alt="" width="1000" height="314" loading="lazy" decoding="async" />
        </picture>
        <img class="explore-card__icon explore-card__icon--historias" src="/images/explore/icon-historias.webp" alt="" aria-hidden="true" width="153" height="160" loading="lazy" decoding="async" />
        <div class="explore-card__copy">
          <h3>Historias</h3>
          <p>Relatos, culturas y saberes tradicionales.</p>
        </div>
        <span class="explore-card__arrow" aria-hidden="true">→</span>
      </a>

      <a class="explore-card" href="#explore" data-explore-reveal style="--explore-order: 3">
        <picture class="explore-card__paper" aria-hidden="true">
          <source
            type="image/webp"
            srcset="/images/explore/paper-3-720.webp 720w, /images/explore/paper-3-1000.webp 1000w"
            sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 1100px) 44vw, 22vw"
          />
          <img src="/images/explore/paper-3-720.webp" alt="" width="1000" height="314" loading="lazy" decoding="async" />
        </picture>
        <img class="explore-card__icon explore-card__icon--evidencia" src="/images/explore/icon-evidencia.webp" alt="" aria-hidden="true" width="150" height="160" loading="lazy" decoding="async" />
        <div class="explore-card__copy">
          <h3>Evidencia</h3>
          <p>Estudios, hallazgos y conocimiento actual.</p>
        </div>
        <span class="explore-card__arrow" aria-hidden="true">→</span>
      </a>

      <a class="explore-card" href="#explore" data-explore-reveal style="--explore-order: 4">
        <picture class="explore-card__paper" aria-hidden="true">
          <source
            type="image/webp"
            srcset="/images/explore/paper-4-720.webp 720w, /images/explore/paper-4-1000.webp 1000w"
            sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 1100px) 44vw, 22vw"
          />
          <img src="/images/explore/paper-4-720.webp" alt="" width="1000" height="314" loading="lazy" decoding="async" />
        </picture>
        <img class="explore-card__icon explore-card__icon--territorios" src="/images/explore/icon-territorios.svg" alt="" aria-hidden="true" width="82" height="72" loading="lazy" decoding="async" />
        <div class="explore-card__copy">
          <h3>Territorios</h3>
          <p>Ecosistemas, geografía y conservación.</p>
        </div>
        <span class="explore-card__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { initExploreSection } from '../../scripts/explore-section';
  initExploreSection();
</script>
