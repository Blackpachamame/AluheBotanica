---
interface Props {
  number?: string;
  name?: string;
  scientificName?: string;
  authority?: string;
  family?: string;
  type?: string;
  collection?: string;
  source?: string;
}

const {
  number = '001',
  name = 'Salvia',
  scientificName = 'Salvia officinalis',
  authority = 'L.',
  family = 'Lamiaceae',
  type = 'Lámina / espécimen',
  collection = 'Volumen I',
  source = 'En preparación',
} = Astro.props;
---

<aside class="specimen-label" aria-label={`Etiqueta de herbario de ${name}`}>
  <div class="specimen-label__top"><span>ALUHE · HERBARIO I</span><span>Nº {number}</span></div>
  <div class="specimen-label__name">{name}</div>
  <p class="specimen-label__latin"><i>{scientificName}</i> {authority}</p>
  <dl>
    <div><dt>Familia</dt><dd>{family}</dd></div>
    <div><dt>Tipo</dt><dd>{type}</dd></div>
    <div><dt>Colección</dt><dd>{collection}</dd></div>
    <div><dt>Fuente</dt><dd>{source}</dd></div>
  </dl>
</aside>
