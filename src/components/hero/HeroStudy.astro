---
import BotanicalLineArt from './BotanicalLineArt.astro';
---

<section class="hero-study" data-hero-study aria-labelledby="hero-study-title">
  <div class="hero-study__ambient hero-study__ambient--left" aria-hidden="true"></div>
  <div class="hero-study__ambient hero-study__ambient--right" aria-hidden="true"></div>

  <header class="hero-study__header">
    <a class="hero-study__brand" href="#hero-study-title" aria-label="Aluhe, Botánica Oculta">
      <span>ALUHE</span>
      <small>Botánica Oculta</small>
    </a>
    <nav class="hero-study__nav" aria-label="Navegación del prototipo">
      <a href="#hero-study-scene">Archivo</a>
      <a href="/herbarium/">Herbario</a>
      <a href="#hero-study-title">Registro</a>
    </nav>
  </header>

  <div class="hero-study__layout">
    <div class="hero-study__copy" data-reveal="copy">
      <p class="hero-study__eyebrow">Conocimiento vegetal <span>·</span> archivo vivo</p>
      <h1 id="hero-study-title">Plantas.<br />Historias ocultas.<br />Futuros posibles.</h1>
      <p class="hero-study__lead">ALUHE reúne especies, historias y evidencias para observar el mundo vegetal con más atención. Un archivo para descubrir cómo nombramos, habitamos y comprendemos las plantas.</p>
      <div class="hero-study__actions">
        <a class="paint-button" href="#hero-study-scene"><span>Explorar archivo</span><b aria-hidden="true">→</b></a>
        <span class="hero-study__scroll-hint"><i aria-hidden="true">↓</i> Desplazá para explorar</span>
      </div>
      <div class="hero-study__volume" aria-label="Registro destacado">
        <span>01 / 17</span>
        <i aria-hidden="true"></i>
        <div><strong>Volumen I</strong><em>Salvia officinalis L.</em></div>
      </div>
    </div>

    <div class="hero-study__visual" id="hero-study-scene" data-reveal="scene">
      <div class="hero-study__sketch" aria-hidden="true">
        <BotanicalLineArt />
      </div>

      <div class="hero-study__paper-stack hero-study__paper-stack--back-3" data-reveal="stack" style="--reveal-order: 1" aria-hidden="true"></div>
      <div class="hero-study__paper-stack hero-study__paper-stack--back-2" data-reveal="stack" style="--reveal-order: 2" aria-hidden="true"></div>
      <div class="hero-study__paper-stack hero-study__paper-stack--back-1" data-reveal="stack" style="--reveal-order: 3" aria-hidden="true"></div>

      <figure class="hero-study__sheet" data-reveal="sheet">
        <div class="hero-study__specimen" data-reveal="plate">
          <img src="/images/salvia/salvia-kohler-plate-38-web.webp" width="1600" height="2284" alt="Ilustración histórica de Salvia officinalis de Köhler, 1887" />
        </div>
        <figcaption class="hero-study__notation">
          <span>Salvia officinalis L.</span>
          <span>Lamiaceae</span>
          <small>Europa mediterránea</small>
        </figcaption>
        <div class="hero-study__tape" aria-hidden="true"></div>
      </figure>

      <a class="hero-paper-link hero-paper-link--taxonomy" href="/herbarium/#taxonomia" data-reveal="note" style="--reveal-order:1">
        <span class="hero-paper-link__number">01</span>
        <span class="hero-paper-link__rule" aria-hidden="true"></span>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 36c12-1 22-9 28-26-16 3-27 12-28 26Zm3-3c8-7 14-12 22-18M21 27c-3-1-5-3-7-5M28 21c0-3-1-5-2-7"/></svg>
        <strong>Taxonomía</strong>
        <em>Clasificación, nombre científico y familia.</em>
        <b aria-hidden="true">→</b>
      </a>

      <a class="hero-paper-link hero-paper-link--habitat" href="/herbarium/#habitat" data-reveal="note" style="--reveal-order:2">
        <span class="hero-paper-link__number">02</span>
        <span class="hero-paper-link__rule" aria-hidden="true"></span>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="m5 34 12-16 8 9 7-12 11 19H5Zm5 0v-9m27 9v-8M9 21c5-5 9-7 13-8"/></svg>
        <strong>Hábitat</strong>
        <em>Dónde crece, cómo se adapta y con quién convive.</em>
        <b aria-hidden="true">→</b>
      </a>

      <a class="hero-paper-link hero-paper-link--evidence" href="/herbarium/#evidencia" data-reveal="note" style="--reveal-order:3">
        <span class="hero-paper-link__number">04</span>
        <span class="hero-paper-link__rule" aria-hidden="true"></span>
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M20 6h8M22 6v12L12 37c-2 4 0 6 4 6h16c4 0 6-2 4-6L26 18V6M17 31h14M19 26h10"/></svg>
        <strong>Evidencia</strong>
        <em>Estudios, hallazgos y conocimiento actual.</em>
        <b aria-hidden="true">→</b>
      </a>

      <div class="hero-study__magnifier" aria-hidden="true">
        <div class="hero-study__magnifier-glass"></div>
      </div>

      <span class="hero-study__stamp" aria-hidden="true">HERBARIO<br /><b>ALUHE</b></span>
    </div>
  </div>
</section>

<script>
  import { initHeroStudy } from '../../scripts/hero-study';
  initHeroStudy();
</script>
